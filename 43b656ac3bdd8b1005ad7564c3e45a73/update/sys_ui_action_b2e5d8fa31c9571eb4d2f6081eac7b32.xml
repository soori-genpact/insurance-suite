<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_action">
    <sys_ui_action action="INSERT_OR_UPDATE">
        <action_name>reject_extraction_review</action_name>
        <active>true</active>
        <client>false</client>
        <comments>Reject the extraction on a HITL extraction-review task: discards the staged data, closes the task as Rejected (117) and rejects the intake case.</comments>
        <condition>current.getValue('u_type') == 'extraction_review' &amp;&amp; current.getValue('active') == '1'</condition>
        <form_action>true</form_action>
        <form_button>true</form_button>
        <form_button_v2>false</form_button_v2>
        <form_context_menu>false</form_context_menu>
        <form_link>false</form_link>
        <form_menu_button_v2>false</form_menu_button_v2>
        <form_style>destructive</form_style>
        <hint>Discard the extracted data and close this task as Rejected</hint>
        <isolate_script>true</isolate_script>
        <list_action>false</list_action>
        <list_banner_button>false</list_banner_button>
        <list_button>false</list_button>
        <name>Reject</name>
        <onclick/>
        <order>110</order>
        <script><![CDATA[(function rejectExtractionReview() {
    var result = new x_gegis_ins_policy.SubmissionApiService().rejectTask(current);
    if (result && result.success)
        gs.addInfoMessage('Extraction rejected. Task ' + current.getValue('number') + ' closed as Rejected.');
    else
        gs.addErrorMessage('Reject failed: ' + (result && result.errorMessage ? result.errorMessage : 'unknown error'));
    action.setRedirectURL(current);
})();]]></script>
