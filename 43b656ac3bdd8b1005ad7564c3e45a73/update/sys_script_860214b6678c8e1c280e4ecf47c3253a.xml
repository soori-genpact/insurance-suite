        <rest_variables/>
        <role_conditions/>
        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

    var url = String(current.url || '');
    if (!url) {
        current.doc_link = '';
        return;
    }
    var name = String(current.document_name || '') || 'Document';
    current.doc_link = '<a href="' + url.replace(/"/g, '&quot;') + '" target="_blank" rel="noopener">' +
        GlideStringUtil.escapeHTML(name) + '</a>';

})(current, previous);]]></script>
