        <script>(function executeRule(current, previous /*null when async*/) {

    if (current.submission.nil())
        return;

    var sub = new GlideRecord('x_gegis_ins_policy_submission');
    if (sub.get(current.submission + ''))
        current.number = sub.number + '-Q';

})(current, previous);</script>
